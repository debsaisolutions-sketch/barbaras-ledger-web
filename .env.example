# Copy to `.env` locally. Restart `npm run dev` after any change (Vite reads env at startup).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_legacy_anon_key

# Server only. Same DocuSeal account as TradeDeskPro. Do not prefix with VITE_.
# DOCUSEAL_API_KEY=
# Optional. When set, only templates in this DocuSeal folder are offered.
# DOCUSEAL_FOLDER=
